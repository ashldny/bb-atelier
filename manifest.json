{
  "name": "Bb Atelier: Dark Mode, Themes & Fonts for Blackboard",
  "short_name": "Bb Atelier",
  "description": "Dark mode, color themes, fonts, text size and course covers for Blackboard Ultra. Use and share themes made by other students.",
  "version": "2.2",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage", "unlimitedStorage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "host_permissions": [
    "*://elearning.qu.edu.qa/*",
    "*://*.blackboard.com/*",
    "*://*.ultra.blackboard.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bb Atelier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://elearning.qu.edu.qa/*",
        "*://*.blackboard.com/*",
        "*://*.ultra.blackboard.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Fonts/*/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
