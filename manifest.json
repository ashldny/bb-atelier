{
  "name": "Bb Atelier",
  "description": "Customize Blackboard Ultra appearance",
  "version": "2.0",
  "manifest_version": 3,

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "*://elearning.qu.edu.qa/*",
    "*://*.blackboard.com/*",
    "*://*.ultra.blackboard.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Bb Atelier",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },

  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },

  "content_scripts": [
    {
      "matches": [
        "*://elearning.qu.edu.qa/*",
        "*://*.blackboard.com/*",
        "*://*.ultra.blackboard.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
