{
  "name": "bb-atelier",
  "version": "2.2.0",
  "description": "Blackboard Ultra Theme Studio",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:rollup": "rollup -c",
    "build:esbuild": "npm run build",
    "dev": "rollup -c -w",
    "dev:esbuild": "npm run dev",
    "lint": "eslint src/ --ext .js --max-warnings 0 && node scripts/lint-extension.js",
    "lint:strict": "npm run lint",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"*.{html,json,js}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"*.{html,json,js}\"",
    "test": "node --test tests/*.test.js",
    "package": "npm run build && node scripts/package-extension.js",
    "pretest": "npm run build",
    "privacy": "node scripts/build-privacy-page.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.2",
    "prettier": "^3.3.3",
    "rollup": "^4.9.6",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "colord": "^2.10.0",
    "css": "^3.0.0",
    "lucide": "^1.37.0",
    "postcss-value-parser": "^4.2.0"
  },
  "overrides": {
    "decode-uri-component": "^0.5.1"
  }
}
